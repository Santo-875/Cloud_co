{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Cloud Copilot Source Manifest Schema",
  "description": "Validates data/sources.yaml entries",
  "type": "object",
  "required": ["sources"],
  "additionalProperties": false,
  "properties": {
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type", "url_or_repo", "pinned_version", "license_note", "parser", "refresh_command"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{1,80}$",
            "description": "Unique snake_case identifier"
          },
          "type": {
            "type": "string",
            "enum": ["cli_guide", "cli_reference", "terraform_provider", "pricing_concept", "price_data", "security_check"]
          },
          "url_or_repo": {
            "type": "string",
            "minLength": 5,
            "description": "Canonical URL or owner/repo GitHub reference"
          },
          "pinned_version": {
            "type": "string",
            "minLength": 1,
            "description": "Release tag, commit SHA, or YYYY-MM-DD fetch date"
          },
          "license_note": {
            "type": "string",
            "minLength": 3
          },
          "parser": {
            "type": "string",
            "enum": ["cli_guide", "cli_reference", "terraform_provider", "pricing_concept", "price_data", "security_check"]
          },
          "refresh_command": {
            "type": "string",
            "minLength": 5
          }
        }
      }
    }
  }
}
