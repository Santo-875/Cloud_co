# Auto-generated by Cloud Copilot
# Architecture: {{ name | hcl_string }}
# Target Region: {{ region | hcl_string }}

{% for node in nodes %}
{% if node.type == "vpc" %}
# Resource: VPC {{ node.id }}
resource "aws_vpc" "{{ node.id }}" {
  cidr_block           = "{{ node.props.cidr | hcl_string }}"
  enable_dns_hostnames = true
  enable_dns_support   = true

  tags = {
    Name        = "{{ node.id | hcl_string }}"
    Environment = var.environment
    ManagedBy   = "cloud-copilot"
  }
}

{% elif node.type == "internet_gateway" %}
# Resource: Internet Gateway {{ node.id }}
resource "aws_internet_gateway" "{{ node.id }}" {
  vpc_id = aws_vpc.{{ node.parent }}.id

  tags = {
    Name        = "{{ node.id | hcl_string }}"
    Environment = var.environment
    ManagedBy   = "cloud-copilot"
  }
}

{% elif node.type == "route_table" %}
# Resource: Route Table {{ node.id }}
resource "aws_route_table" "{{ node.id }}" {
  vpc_id = aws_vpc.{{ node.parent }}.id

  {% for r in node.props.routes | default([]) %}
  route {
    cidr_block = "{{ r.cidr_block | hcl_string }}"
    {% if r.gateway_id is defined %}
    gateway_id = aws_internet_gateway.{{ r.gateway_id }}.id
    {% endif %}
  }
  {% endfor %}

  tags = {
    Name        = "{{ node.id | hcl_string }}"
    Environment = var.environment
    ManagedBy   = "cloud-copilot"
  }
}

{% elif node.type == "subnet" %}
# Resource: Subnet {{ node.id }}
resource "aws_subnet" "{{ node.id }}" {
  vpc_id                  = aws_vpc.{{ node.parent }}.id
  cidr_block              = "{{ node.props.cidr | hcl_string }}"
  map_public_ip_on_launch = {{ "true" if node.props.public else "false" }}
  {% if node.props.az is defined and node.props.az %}
  availability_zone       = "{{ node.props.az | hcl_string }}"
  {% endif %}

  tags = {
    Name        = "{{ node.id | hcl_string }}"
    Environment = var.environment
    ManagedBy   = "cloud-copilot"
  }
}

{% if node.props.public and node.synth_route_table_id is defined %}
resource "aws_route_table_association" "{{ node.id }}_assoc" {
  subnet_id      = aws_subnet.{{ node.id }}.id
  route_table_id = aws_route_table.{{ node.synth_route_table_id }}.id
}
{% endif %}

{% elif node.type == "security_group" %}
# Resource: Security Group {{ node.id }}
resource "aws_security_group" "{{ node.id }}" {
  name        = "{{ node.id | hcl_string }}"
  description = "{{ (node.props.description | default('Managed by Cloud Copilot')) | hcl_string }}"
  vpc_id      = aws_vpc.{{ node.parent }}.id

  {% for rule in node.props.ingress | default([]) %}
  ingress {
    from_port   = {{ rule.port }}
    to_port     = {{ rule.to_port if rule.to_port is defined and rule.to_port is not none else rule.port }}
    protocol    = "{{ rule.protocol | hcl_string }}"
    cidr_blocks = ["{{ rule.cidr | hcl_string }}"]
  }
  {% endfor %}

  {% for rule in node.props.egress | default([]) %}
  egress {
    from_port   = {{ rule.port if rule.port is defined and rule.port is not none else 0 }}
    to_port     = {{ rule.to_port if rule.to_port is defined and rule.to_port is not none else 0 }}
    protocol    = "{{ rule.protocol | hcl_string }}"
    cidr_blocks = ["{{ rule.cidr | hcl_string }}"]
  }
  {% endfor %}

  tags = {
    Name        = "{{ node.id | hcl_string }}"
    Environment = var.environment
    ManagedBy   = "cloud-copilot"
  }
}

{% elif node.type == "ec2" %}
# Resource: EC2 Instance {{ node.id }}
resource "aws_instance" "{{ node.id }}" {
  ami           = "ami-0c55b159cbfafe1f0" # Amazon Linux 2 placeholder
  instance_type = "{{ node.props.instance_type | default('t3.micro') | hcl_string }}"
  subnet_id     = aws_subnet.{{ node.parent }}.id

  {% if node.security_groups %}
  vpc_security_group_ids = [
    {% for sg_id in node.security_groups %}
    aws_security_group.{{ sg_id }}.id,
    {% endfor %}
  ]
  {% endif %}

  root_block_device {
    encrypted = {{ "true" if node.props.ebs_encrypted else "false" }}
  }

  {% if node.props.key_name is defined and node.props.key_name %}
  key_name = "{{ node.props.key_name | hcl_string }}"
  {% endif %}

  tags = {
    Name        = "{{ node.id | hcl_string }}"
    Environment = var.environment
    ManagedBy   = "cloud-copilot"
  }
}

{% elif node.type == "s3" %}
# Resource: S3 Bucket {{ node.id }}
resource "aws_s3_bucket" "{{ node.id }}" {
  bucket = "{{ node.id | hcl_string }}"

  tags = {
    Name        = "{{ node.id | hcl_string }}"
    Environment = var.environment
    ManagedBy   = "cloud-copilot"
  }
}

resource "aws_s3_bucket_versioning" "{{ node.id }}_versioning" {
  bucket = aws_s3_bucket.{{ node.id }}.id
  versioning_configuration {
    status = "{{ 'Enabled' if node.props.versioning else 'Suspended' }}"
  }
}

resource "aws_s3_bucket_server_side_encryption_configuration" "{{ node.id }}_encryption" {
  bucket = aws_s3_bucket.{{ node.id }}.id
  rule {
    apply_server_side_encryption_by_default {
      sse_algorithm = "AES256"
    }
  }
}

resource "aws_s3_bucket_public_access_block" "{{ node.id }}_pab" {
  bucket = aws_s3_bucket.{{ node.id }}.id

  block_public_acls       = {{ "false" if node.props.public else "true" }}
  block_public_policy     = {{ "false" if node.props.public else "true" }}
  ignore_public_acls      = {{ "false" if node.props.public else "true" }}
  restrict_public_buckets = {{ "false" if node.props.public else "true" }}
}

{% elif node.type == "ebs" %}
# Resource: EBS Volume {{ node.id }}
resource "aws_ebs_volume" "{{ node.id }}" {
  availability_zone = "${var.aws_region}a"
  size              = {{ node.props.size_gb | default(20) }}
  encrypted         = {{ "true" if node.props.encrypted else "false" }}
  type              = "{{ node.props.volume_type | default('gp3') | hcl_string }}"

  tags = {
    Name        = "{{ node.id | hcl_string }}"
    Environment = var.environment
    ManagedBy   = "cloud-copilot"
  }
}

{% elif node.type == "rds" %}
# Resource: RDS Instance {{ node.id }}
resource "aws_db_instance" "{{ node.id }}" {
  identifier          = "{{ node.id | hcl_string }}"
  engine              = "{{ node.props.engine | default('postgres') | hcl_string }}"
  instance_class      = "{{ node.props.instance_class | default('db.t3.micro') | hcl_string }}"
  allocated_storage   = {{ node.props.allocated_storage | default(20) }}
  storage_encrypted   = {{ "true" if node.props.storage_encrypted else "false" }}
  publicly_accessible = {{ "true" if node.props.publicly_accessible else "false" }}
  skip_final_snapshot = true

  tags = {
    Name        = "{{ node.id | hcl_string }}"
    Environment = var.environment
    ManagedBy   = "cloud-copilot"
  }
}

{% elif node.type == "cloudwatch" %}
# Resource: CloudWatch Log Group {{ node.id }}
resource "aws_cloudwatch_log_group" "{{ node.id }}" {
  name              = "/cloud-copilot/{{ node.id | hcl_string }}"
  retention_in_days = {{ node.props.retention_days | default(30) }}

  tags = {
    Name        = "{{ node.id | hcl_string }}"
    Environment = var.environment
    ManagedBy   = "cloud-copilot"
  }
}

{% elif node.type == "sns" %}
# Resource: SNS Topic {{ node.id }}
resource "aws_sns_topic" "{{ node.id }}" {
  name         = "{{ node.id | hcl_string }}"
  display_name = "{{ (node.props.display_name | default(node.id)) | hcl_string }}"

  tags = {
    Name        = "{{ node.id | hcl_string }}"
    Environment = var.environment
    ManagedBy   = "cloud-copilot"
  }
}

{% elif node.type == "iam_role" %}
# Resource: IAM Role {{ node.id }}
resource "aws_iam_role" "{{ node.id }}" {
  name = "{{ node.id | hcl_string }}"

  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Action = "sts:AssumeRole"
        Effect = "Allow"
        Principal = {
          Service = "{{ node.props.assume_role_service | default('ec2.amazonaws.com') | hcl_string }}"
        }
      }
    ]
  })

  tags = {
    Name        = "{{ node.id | hcl_string }}"
    Environment = var.environment
    ManagedBy   = "cloud-copilot"
  }
}
{% endif %}
{% endfor %}
